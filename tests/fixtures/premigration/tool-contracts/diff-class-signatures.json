{
  "description": "Pre-migration per-tool contract snapshot: advertised tools/list entry with VERBATIM inputSchema bytes (wire property order), plus one envelope sample. Untouched SDK v1 build; legacy handshake; default flag config.",
  "harness": "scripts/premigration/capture-tool-contracts.mjs",
  "env": {
    "MCP_CACHE_DIR": "<SCRATCH>/cache",
    "MCP_SQLITE_PATH": "<SCRATCH>/cache/source-cache.db",
    "MCP_SUPERVISOR_CHILD_PID_FILE": "<SCRATCH>/run/tool-contracts.pid"
  },
  "advertised": {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Compare one class signature between two Minecraft versions and report added/removed/modified constructors, methods, and fields. Expert tool: prefer the entry tools (inspect-minecraft, analyze-symbol, compare-minecraft, analyze-mod, validate-project) first.",
    "execution": {
      "taskSupport": "forbidden"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        },
        "fromVersion": {
          "$ref": "#/properties/className"
        },
        "toVersion": {
          "$ref": "#/properties/className"
        },
        "mapping": {
          "type": "string",
          "enum": [
            "obfuscated",
            "mojang",
            "intermediary",
            "yarn"
          ],
          "description": "default obfuscated"
        },
        "sourcePriority": {
          "type": "string",
          "enum": [
            "loom-first",
            "maven-first"
          ]
        },
        "gradleUserHome": {
          "type": "string",
          "minLength": 1,
          "description": "Gradle user home for Loom cache lookups (overrides GRADLE_USER_HOME)."
        },
        "includeFullDiff": {
          "type": "boolean",
          "default": true,
          "description": "When false, omit from/to snapshots from modified entries and keep only key+changed"
        }
      },
      "required": [
        "className",
        "fromVersion",
        "toVersion"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "name": "diff-class-signatures"
  },
  "envelopeSample": {
    "kind": "invalid-input",
    "request": {
      "id": 15,
      "jsonrpc": "2.0",
      "method": "tools/call",
      "params": {
        "arguments": {},
        "name": "diff-class-signatures"
      }
    },
    "reply": {
      "id": 15,
      "jsonrpc": "2.0",
      "result": {
        "content": [
          {
            "text": {
              "__normalizedJson": {
                "error": {
                  "code": "ERR_INVALID_INPUT",
                  "detail": "Request validation failed.",
                  "fieldErrors": [
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "className"
                    },
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "fromVersion"
                    },
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "toVersion"
                    }
                  ],
                  "hints": [
                    "Check fieldErrors and submit a valid tool argument payload."
                  ],
                  "instance": "<REQUEST_ID>",
                  "issueOrigin": "code_issue",
                  "retryClass": "input",
                  "status": 400,
                  "title": "Invalid input",
                  "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
                },
                "meta": {
                  "durationMs": "<DURATION_MS>",
                  "requestId": "<REQUEST_ID>",
                  "tool": "diff-class-signatures"
                }
              }
            },
            "type": "text"
          }
        ],
        "isError": true,
        "structuredContent": {
          "error": {
            "code": "ERR_INVALID_INPUT",
            "detail": "Request validation failed.",
            "fieldErrors": [
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "className"
              },
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "fromVersion"
              },
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "toVersion"
              }
            ],
            "hints": [
              "Check fieldErrors and submit a valid tool argument payload."
            ],
            "instance": "<REQUEST_ID>",
            "issueOrigin": "code_issue",
            "retryClass": "input",
            "status": 400,
            "title": "Invalid input",
            "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
          },
          "meta": {
            "durationMs": "<DURATION_MS>",
            "requestId": "<REQUEST_ID>",
            "tool": "diff-class-signatures"
          }
        }
      }
    }
  }
}
