{
  "description": "Pre-migration per-tool contract snapshot: advertised tools/list entry with VERBATIM inputSchema bytes (wire property order), plus one envelope sample. Untouched SDK v1 build; legacy handshake; default flag config.",
  "harness": "scripts/premigration/capture-tool-contracts.mjs",
  "env": {
    "MCP_CACHE_DIR": "<SCRATCH>/cache",
    "MCP_SQLITE_PATH": "<SCRATCH>/cache/source-cache.db",
    "MCP_SUPERVISOR_CHILD_PID_FILE": "<SCRATCH>/run/tool-contracts.pid"
  },
  "advertised": {
    "annotations": {
      "readOnlyHint": false
    },
    "description": "Remap a Fabric mod JAR from intermediary to yarn/mojang names. Requires Java to be installed. Expert tool: prefer the entry tools (inspect-minecraft, analyze-symbol, compare-minecraft, analyze-mod, validate-project) first.",
    "execution": {
      "taskSupport": "forbidden"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "inputJar": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the mod JAR file"
        },
        "outputJar": {
          "type": "string",
          "minLength": 1,
          "description": "Output path for remapped JAR (auto-generated if omitted)"
        },
        "mcVersion": {
          "$ref": "#/properties/outputJar",
          "description": "Minecraft version (auto-detected from mod metadata if omitted)"
        },
        "targetMapping": {
          "type": "string",
          "enum": [
            "yarn",
            "mojang"
          ]
        },
        "forceRemap": {
          "type": "boolean",
          "description": "Skip the cache and re-resolve the newest yarn build (busts a stale remap)"
        }
      },
      "required": [
        "inputJar",
        "targetMapping"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "name": "remap-mod-jar"
  },
  "envelopeSample": {
    "kind": "invalid-input",
    "request": {
      "id": 32,
      "jsonrpc": "2.0",
      "method": "tools/call",
      "params": {
        "arguments": {},
        "name": "remap-mod-jar"
      }
    },
    "reply": {
      "id": 32,
      "jsonrpc": "2.0",
      "result": {
        "content": [
          {
            "text": {
              "__normalizedJson": {
                "error": {
                  "code": "ERR_INVALID_INPUT",
                  "detail": "Request validation failed.",
                  "fieldErrors": [
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "inputJar"
                    },
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "targetMapping"
                    }
                  ],
                  "hints": [
                    "Check fieldErrors and submit a valid tool argument payload."
                  ],
                  "instance": "<REQUEST_ID>",
                  "issueOrigin": "code_issue",
                  "retryClass": "input",
                  "status": 400,
                  "title": "Invalid input",
                  "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
                },
                "meta": {
                  "durationMs": "<DURATION_MS>",
                  "requestId": "<REQUEST_ID>",
                  "tool": "remap-mod-jar"
                }
              }
            },
            "type": "text"
          }
        ],
        "isError": true,
        "structuredContent": {
          "error": {
            "code": "ERR_INVALID_INPUT",
            "detail": "Request validation failed.",
            "fieldErrors": [
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "inputJar"
              },
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "targetMapping"
              }
            ],
            "hints": [
              "Check fieldErrors and submit a valid tool argument payload."
            ],
            "instance": "<REQUEST_ID>",
            "issueOrigin": "code_issue",
            "retryClass": "input",
            "status": 400,
            "title": "Invalid input",
            "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
          },
          "meta": {
            "durationMs": "<DURATION_MS>",
            "requestId": "<REQUEST_ID>",
            "tool": "remap-mod-jar"
          }
        }
      }
    }
  }
}
