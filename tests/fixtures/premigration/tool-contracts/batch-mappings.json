{
  "description": "Pre-migration per-tool contract snapshot: advertised tools/list entry with VERBATIM inputSchema bytes (wire property order), plus one envelope sample. Untouched SDK v1 build; legacy handshake; default flag config.",
  "harness": "scripts/premigration/capture-tool-contracts.mjs",
  "env": {
    "MCP_CACHE_DIR": "<SCRATCH>/cache",
    "MCP_SQLITE_PATH": "<SCRATCH>/cache/source-cache.db",
    "MCP_SUPERVISOR_CHILD_PID_FILE": "<SCRATCH>/run/tool-contracts.pid"
  },
  "advertised": {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Batch find-mapping: resolve many symbols across mapping namespaces with one shared Minecraft version.",
    "execution": {
      "taskSupport": "forbidden"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Minecraft version shared by every entry (single-version batch)."
        },
        "sourcePriority": {
          "type": "string",
          "enum": [
            "loom-first",
            "maven-first"
          ]
        },
        "projectPath": {
          "type": "string",
          "minLength": 1
        },
        "gradleUserHome": {
          "$ref": "#/properties/projectPath",
          "description": "Gradle user home for Loom cache lookups (overrides GRADLE_USER_HOME)."
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "failFast": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "enum": [
            "summary",
            "standard",
            "full"
          ],
          "default": "summary",
          "description": "summary = terse (drops diagnostics/empties, slims candidates); standard = keeps fields, drops heavy diagnostics; full = everything."
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "warnings",
              "provenance",
              "candidates",
              "members",
              "descriptors",
              "source",
              "files",
              "samples",
              "diff",
              "issues",
              "timeline",
              "matrix",
              "entries",
              "workspace",
              "health",
              "recovery",
              "paths",
              "owners",
              "preview",
              "cacheEntries",
              "timings",
              "artifact",
              "classes",
              "registry"
            ]
          },
          "description": "Field groups to include regardless of detail, e.g. [\"provenance\"]."
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "class",
                  "field",
                  "method"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "$ref": "#/properties/projectPath"
              },
              "descriptor": {
                "type": "string"
              },
              "sourceMapping": {
                "type": "string",
                "enum": [
                  "obfuscated",
                  "mojang",
                  "intermediary",
                  "yarn"
                ]
              },
              "targetMapping": {
                "$ref": "#/properties/entries/items/properties/sourceMapping"
              },
              "signatureMode": {
                "type": "string",
                "enum": [
                  "exact",
                  "name-only"
                ]
              },
              "disambiguation": {
                "type": "object",
                "properties": {
                  "ownerHint": {
                    "$ref": "#/properties/projectPath"
                  },
                  "descriptorHint": {
                    "$ref": "#/properties/projectPath"
                  }
                },
                "additionalProperties": false
              },
              "maxCandidates": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "kind",
              "name",
              "sourceMapping",
              "targetMapping"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 50
        }
      },
      "required": [
        "version",
        "entries"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "name": "batch-mappings"
  },
  "envelopeSample": {
    "kind": "invalid-input",
    "request": {
      "id": 9,
      "jsonrpc": "2.0",
      "method": "tools/call",
      "params": {
        "arguments": {},
        "name": "batch-mappings"
      }
    },
    "reply": {
      "id": 9,
      "jsonrpc": "2.0",
      "result": {
        "content": [
          {
            "text": {
              "__normalizedJson": {
                "error": {
                  "code": "ERR_INVALID_INPUT",
                  "detail": "Request validation failed.",
                  "fieldErrors": [
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "version"
                    },
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "entries"
                    }
                  ],
                  "hints": [
                    "Check fieldErrors and submit a valid tool argument payload."
                  ],
                  "instance": "<REQUEST_ID>",
                  "issueOrigin": "code_issue",
                  "retryClass": "input",
                  "status": 400,
                  "title": "Invalid input",
                  "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
                },
                "meta": {
                  "durationMs": "<DURATION_MS>",
                  "requestId": "<REQUEST_ID>",
                  "tool": "batch-mappings"
                }
              }
            },
            "type": "text"
          }
        ],
        "isError": true,
        "structuredContent": {
          "error": {
            "code": "ERR_INVALID_INPUT",
            "detail": "Request validation failed.",
            "fieldErrors": [
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "version"
              },
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "entries"
              }
            ],
            "hints": [
              "Check fieldErrors and submit a valid tool argument payload."
            ],
            "instance": "<REQUEST_ID>",
            "issueOrigin": "code_issue",
            "retryClass": "input",
            "status": 400,
            "title": "Invalid input",
            "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
          },
          "meta": {
            "durationMs": "<DURATION_MS>",
            "requestId": "<REQUEST_ID>",
            "tool": "batch-mappings"
          }
        }
      }
    }
  }
}
