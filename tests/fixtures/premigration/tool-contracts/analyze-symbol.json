{
  "description": "Pre-migration per-tool contract snapshot: advertised tools/list entry with VERBATIM inputSchema bytes (wire property order), plus one envelope sample. Untouched SDK v1 build; legacy handshake; default flag config.",
  "harness": "scripts/premigration/capture-tool-contracts.mjs",
  "env": {
    "MCP_CACHE_DIR": "<SCRATCH>/cache",
    "MCP_SQLITE_PATH": "<SCRATCH>/cache/source-cache.db",
    "MCP_SUPERVISOR_CHILD_PID_FILE": "<SCRATCH>/run/tool-contracts.pid"
  },
  "advertised": {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Top-level workflow tool for symbol existence, mapping, lifecycle, workspace analysis, and API overview. subject.kind='symbol' auto-detects class/field/method from the selector.",
    "execution": {
      "taskSupport": "forbidden"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "enum": [
            "exists",
            "map",
            "exact-map",
            "lifecycle",
            "workspace",
            "api-overview"
          ]
        },
        "subject": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "class",
                "method",
                "field",
                "symbol"
              ],
              "description": "Symbol kind. Use 'symbol' to auto-detect from the selector: owner+descriptor => method, owner only => field, otherwise => class. The inferred kind is reported as a warning. For task=api-overview the inferred kind must be class."
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "$ref": "#/properties/subject/properties/name"
            },
            "descriptor": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        "version": {
          "$ref": "#/properties/subject/properties/name",
          "description": "Point-in-time MC version for task=exists/map/exact-map/workspace/api-overview. For task=lifecycle it is accepted as a back-compat alias for toVersion (range end)."
        },
        "fromVersion": {
          "$ref": "#/properties/subject/properties/name",
          "description": "task=lifecycle only: range start (oldest) version; defaults to the oldest version in the manifest."
        },
        "toVersion": {
          "$ref": "#/properties/subject/properties/name",
          "description": "task=lifecycle only: range end (newest) version; takes precedence over version. Defaults to latest."
        },
        "maxVersions": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 400,
          "description": "task=lifecycle only: cap on scanned versions (service default 120, max 400)."
        },
        "includeTimeline": {
          "type": "boolean",
          "description": "task=lifecycle only: include per-version timeline entries."
        },
        "includeSnapshots": {
          "type": "boolean",
          "description": "task=lifecycle only: include snapshot versions in the scan."
        },
        "sourceMapping": {
          "type": "string",
          "enum": [
            "obfuscated",
            "mojang",
            "intermediary",
            "yarn"
          ]
        },
        "targetMapping": {
          "type": "string",
          "enum": [
            "obfuscated",
            "mojang",
            "intermediary",
            "yarn"
          ]
        },
        "classNameMapping": {
          "type": "string",
          "enum": [
            "obfuscated",
            "mojang",
            "intermediary",
            "yarn"
          ]
        },
        "projectPath": {
          "$ref": "#/properties/subject/properties/name"
        },
        "gradleUserHome": {
          "$ref": "#/properties/subject/properties/name"
        },
        "signatureMode": {
          "type": "string",
          "enum": [
            "exact",
            "name-only"
          ],
          "default": "exact"
        },
        "nameMode": {
          "type": "string",
          "enum": [
            "fqcn",
            "auto"
          ],
          "default": "auto"
        },
        "includeKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "class",
              "field",
              "method"
            ]
          }
        },
        "maxRows": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "maxCandidates": {
          "$ref": "#/properties/maxRows",
          "default": 5
        },
        "detail": {
          "type": "string",
          "enum": [
            "summary",
            "standard",
            "full"
          ]
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "warnings",
              "candidates",
              "matrix",
              "workspace",
              "timings"
            ]
          }
        }
      },
      "required": [
        "task",
        "subject"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "name": "analyze-symbol"
  },
  "envelopeSample": {
    "kind": "invalid-input",
    "request": {
      "id": 6,
      "jsonrpc": "2.0",
      "method": "tools/call",
      "params": {
        "arguments": {},
        "name": "analyze-symbol"
      }
    },
    "reply": {
      "id": 6,
      "jsonrpc": "2.0",
      "result": {
        "content": [
          {
            "text": {
              "__normalizedJson": {
                "error": {
                  "code": "ERR_INVALID_INPUT",
                  "detail": "Request validation failed.",
                  "fieldErrors": [
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "task"
                    },
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "subject"
                    }
                  ],
                  "hints": [
                    "Check fieldErrors and submit a valid tool argument payload."
                  ],
                  "instance": "<REQUEST_ID>",
                  "issueOrigin": "code_issue",
                  "retryClass": "input",
                  "status": 400,
                  "title": "Invalid input",
                  "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
                },
                "meta": {
                  "durationMs": "<DURATION_MS>",
                  "requestId": "<REQUEST_ID>",
                  "tool": "analyze-symbol"
                }
              }
            },
            "type": "text"
          }
        ],
        "isError": true,
        "structuredContent": {
          "error": {
            "code": "ERR_INVALID_INPUT",
            "detail": "Request validation failed.",
            "fieldErrors": [
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "task"
              },
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "subject"
              }
            ],
            "hints": [
              "Check fieldErrors and submit a valid tool argument payload."
            ],
            "instance": "<REQUEST_ID>",
            "issueOrigin": "code_issue",
            "retryClass": "input",
            "status": 400,
            "title": "Invalid input",
            "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
          },
          "meta": {
            "durationMs": "<DURATION_MS>",
            "requestId": "<REQUEST_ID>",
            "tool": "analyze-symbol"
          }
        }
      }
    }
  }
}
