{
  "description": "Pre-migration per-tool contract snapshot: advertised tools/list entry with VERBATIM inputSchema bytes (wire property order), plus one envelope sample. Untouched SDK v1 build; legacy handshake; default flag config.",
  "harness": "scripts/premigration/capture-tool-contracts.mjs",
  "env": {
    "MCP_CACHE_DIR": "<SCRATCH>/cache",
    "MCP_SQLITE_PATH": "<SCRATCH>/cache/source-cache.db",
    "MCP_SUPERVISOR_CHILD_PID_FILE": "<SCRATCH>/run/tool-contracts.pid"
  },
  "advertised": {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Batch check-symbol-exists for many symbols against one shared Minecraft version (target.kind=version or workspace only).",
    "execution": {
      "taskSupport": "forbidden"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "version"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "workspace"
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "vanilla",
                    "merged",
                    "loader"
                  ]
                },
                "strict": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Only kind=\"version\" or kind=\"workspace\"; other kinds carry library versions, not MC versions."
        },
        "mapping": {
          "type": "string",
          "enum": [
            "obfuscated",
            "mojang",
            "intermediary",
            "yarn"
          ]
        },
        "sourcePriority": {
          "type": "string",
          "enum": [
            "loom-first",
            "maven-first"
          ]
        },
        "allowDecompile": {
          "type": "boolean"
        },
        "projectPath": {
          "type": "string",
          "minLength": 1
        },
        "gradleUserHome": {
          "$ref": "#/properties/projectPath",
          "description": "Gradle user home for Loom cache lookups (overrides GRADLE_USER_HOME)."
        },
        "scope": {
          "$ref": "#/properties/target/anyOf/1/properties/scope"
        },
        "preferProjectVersion": {
          "type": "boolean"
        },
        "strictVersion": {
          "type": "boolean"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "failFast": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "enum": [
            "summary",
            "standard",
            "full"
          ],
          "default": "summary",
          "description": "summary = terse (drops diagnostics/empties, slims candidates); standard = keeps fields, drops heavy diagnostics; full = everything."
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "warnings",
              "provenance",
              "candidates",
              "members",
              "descriptors",
              "source",
              "files",
              "samples",
              "diff",
              "issues",
              "timeline",
              "matrix",
              "entries",
              "workspace",
              "health",
              "recovery",
              "paths",
              "owners",
              "preview",
              "cacheEntries",
              "timings",
              "artifact",
              "classes",
              "registry"
            ]
          },
          "description": "Field groups to include regardless of detail, e.g. [\"provenance\"]."
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "class",
                  "field",
                  "method"
                ]
              },
              "name": {
                "$ref": "#/properties/target/anyOf/0/properties/value"
              },
              "owner": {
                "$ref": "#/properties/projectPath"
              },
              "descriptor": {
                "type": "string"
              },
              "nameMode": {
                "type": "string",
                "enum": [
                  "fqcn",
                  "auto"
                ]
              },
              "signatureMode": {
                "type": "string",
                "enum": [
                  "exact",
                  "name-only"
                ]
              },
              "maxCandidates": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 50
        }
      },
      "required": [
        "target",
        "entries"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "name": "batch-symbol-exists"
  },
  "envelopeSample": {
    "kind": "invalid-input",
    "request": {
      "id": 10,
      "jsonrpc": "2.0",
      "method": "tools/call",
      "params": {
        "arguments": {},
        "name": "batch-symbol-exists"
      }
    },
    "reply": {
      "id": 10,
      "jsonrpc": "2.0",
      "result": {
        "content": [
          {
            "text": {
              "__normalizedJson": {
                "error": {
                  "code": "ERR_INVALID_INPUT",
                  "detail": "Request validation failed.",
                  "fieldErrors": [
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "target"
                    },
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "entries"
                    }
                  ],
                  "hints": [
                    "Check fieldErrors and submit a valid tool argument payload."
                  ],
                  "instance": "<REQUEST_ID>",
                  "issueOrigin": "code_issue",
                  "retryClass": "input",
                  "status": 400,
                  "title": "Invalid input",
                  "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
                },
                "meta": {
                  "durationMs": "<DURATION_MS>",
                  "requestId": "<REQUEST_ID>",
                  "tool": "batch-symbol-exists"
                }
              }
            },
            "type": "text"
          }
        ],
        "isError": true,
        "structuredContent": {
          "error": {
            "code": "ERR_INVALID_INPUT",
            "detail": "Request validation failed.",
            "fieldErrors": [
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "target"
              },
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "entries"
              }
            ],
            "hints": [
              "Check fieldErrors and submit a valid tool argument payload."
            ],
            "instance": "<REQUEST_ID>",
            "issueOrigin": "code_issue",
            "retryClass": "input",
            "status": 400,
            "title": "Invalid input",
            "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
          },
          "meta": {
            "durationMs": "<DURATION_MS>",
            "requestId": "<REQUEST_ID>",
            "tool": "batch-symbol-exists"
          }
        }
      }
    }
  }
}
