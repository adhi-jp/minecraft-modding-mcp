{
  "description": "Pre-migration per-tool contract snapshot: advertised tools/list entry with VERBATIM inputSchema bytes (wire property order), plus one envelope sample. Untouched SDK v1 build; legacy handshake; default flag config.",
  "harness": "scripts/premigration/capture-tool-contracts.mjs",
  "env": {
    "MCP_CACHE_DIR": "<SCRATCH>/cache",
    "MCP_SQLITE_PATH": "<SCRATCH>/cache/source-cache.db",
    "MCP_SUPERVISOR_CHILD_PID_FILE": "<SCRATCH>/run/tool-contracts.pid"
  },
  "advertised": {
    "annotations": {
      "readOnlyHint": false
    },
    "description": "Batch get-class-source for many classes sharing one resolved artifact; returns per-entry status plus aggregate summary. Not read-only: per-entry outputFile writes to disk.",
    "execution": {
      "taskSupport": "forbidden"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "version"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "jar"
                },
                "value": {
                  "$ref": "#/properties/target/anyOf/0/properties/value"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "coordinate"
                },
                "value": {
                  "$ref": "#/properties/target/anyOf/0/properties/value"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "workspace"
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "vanilla",
                    "merged",
                    "loader"
                  ]
                },
                "strict": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "dependency"
                },
                "group": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Maven group, e.g. \"net.fabricmc.fabric-api\" or \"dev.architectury\"."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Maven artifact name, e.g. \"fabric-api\" or \"architectury\"."
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Explicit version; omit and set versionFromProject to resolve it from the workspace."
                },
                "versionFromProject": {
                  "type": "boolean",
                  "description": "Resolve the version from the project's gradle.properties / gradle cache (requires projectPath)."
                }
              },
              "required": [
                "kind",
                "group",
                "name"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Object, not string. e.g. {\"kind\":\"version\",\"value\":\"1.21.10\"}, {\"kind\":\"workspace\"}, or to inspect a loader/Fabric dependency like vanilla: {\"kind\":\"dependency\",\"group\":\"net.fabricmc.fabric-api\",\"name\":\"fabric-api\",\"versionFromProject\":true} (needs projectPath) or with an explicit \"version\"."
        },
        "mapping": {
          "type": "string",
          "enum": [
            "obfuscated",
            "mojang",
            "intermediary",
            "yarn"
          ]
        },
        "sourcePriority": {
          "type": "string",
          "enum": [
            "loom-first",
            "maven-first"
          ]
        },
        "allowDecompile": {
          "type": "boolean"
        },
        "projectPath": {
          "type": "string",
          "minLength": 1
        },
        "gradleUserHome": {
          "$ref": "#/properties/projectPath",
          "description": "Gradle user home for Loom cache lookups (overrides GRADLE_USER_HOME)."
        },
        "scope": {
          "$ref": "#/properties/target/anyOf/3/properties/scope"
        },
        "preferProjectVersion": {
          "type": "boolean"
        },
        "strictVersion": {
          "type": "boolean"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "1..8, default 4"
        },
        "failFast": {
          "type": "boolean",
          "description": "default false"
        },
        "detail": {
          "type": "string",
          "enum": [
            "summary",
            "standard",
            "full"
          ],
          "default": "summary",
          "description": "summary = terse (drops diagnostics/empties, slims candidates); standard = keeps fields, drops heavy diagnostics; full = everything."
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "warnings",
              "provenance",
              "candidates",
              "members",
              "descriptors",
              "source",
              "files",
              "samples",
              "diff",
              "issues",
              "timeline",
              "matrix",
              "entries",
              "workspace",
              "health",
              "recovery",
              "paths",
              "owners",
              "preview",
              "cacheEntries",
              "timings",
              "artifact",
              "classes",
              "registry"
            ]
          },
          "description": "Field groups to include regardless of detail, e.g. [\"provenance\"]."
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "className": {
                "$ref": "#/properties/target/anyOf/0/properties/value"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "metadata",
                  "snippet",
                  "full"
                ]
              },
              "startLine": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "endLine": {
                "$ref": "#/properties/entries/items/properties/startLine"
              },
              "maxLines": {
                "$ref": "#/properties/entries/items/properties/startLine"
              },
              "maxChars": {
                "$ref": "#/properties/entries/items/properties/startLine"
              },
              "outputFile": {
                "$ref": "#/properties/projectPath"
              }
            },
            "required": [
              "className"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 50,
          "description": "1..50 entries; each shares the resolved target artifact."
        }
      },
      "required": [
        "target",
        "entries"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "name": "batch-class-source"
  },
  "envelopeSample": {
    "kind": "invalid-input",
    "request": {
      "id": 8,
      "jsonrpc": "2.0",
      "method": "tools/call",
      "params": {
        "arguments": {},
        "name": "batch-class-source"
      }
    },
    "reply": {
      "id": 8,
      "jsonrpc": "2.0",
      "result": {
        "content": [
          {
            "text": {
              "__normalizedJson": {
                "error": {
                  "code": "ERR_INVALID_INPUT",
                  "detail": "Request validation failed.",
                  "fieldErrors": [
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "target"
                    },
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "entries"
                    }
                  ],
                  "hints": [
                    "Check fieldErrors and submit a valid tool argument payload."
                  ],
                  "instance": "<REQUEST_ID>",
                  "issueOrigin": "code_issue",
                  "retryClass": "input",
                  "status": 400,
                  "title": "Invalid input",
                  "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
                },
                "meta": {
                  "durationMs": "<DURATION_MS>",
                  "requestId": "<REQUEST_ID>",
                  "tool": "batch-class-source"
                }
              }
            },
            "type": "text"
          }
        ],
        "isError": true,
        "structuredContent": {
          "error": {
            "code": "ERR_INVALID_INPUT",
            "detail": "Request validation failed.",
            "fieldErrors": [
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "target"
              },
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "entries"
              }
            ],
            "hints": [
              "Check fieldErrors and submit a valid tool argument payload."
            ],
            "instance": "<REQUEST_ID>",
            "issueOrigin": "code_issue",
            "retryClass": "input",
            "status": 400,
            "title": "Invalid input",
            "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
          },
          "meta": {
            "durationMs": "<DURATION_MS>",
            "requestId": "<REQUEST_ID>",
            "tool": "batch-class-source"
          }
        }
      }
    }
  }
}
