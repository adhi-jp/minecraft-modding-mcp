{
  "description": "Pre-migration per-tool contract snapshot: advertised tools/list entry with VERBATIM inputSchema bytes (wire property order), plus one envelope sample. Untouched SDK v1 build; legacy handshake; default flag config.",
  "harness": "scripts/premigration/capture-tool-contracts.mjs",
  "env": {
    "MCP_CACHE_DIR": "<SCRATCH>/cache",
    "MCP_SQLITE_PATH": "<SCRATCH>/cache/source-cache.db",
    "MCP_SUPERVISOR_CHILD_PID_FILE": "<SCRATCH>/run/tool-contracts.pid"
  },
  "advertised": {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Get full source file content by artifactId and file path. Expert tool: prefer the entry tools (inspect-minecraft, analyze-symbol, compare-minecraft, analyze-mod, validate-project) first.",
    "execution": {
      "taskSupport": "forbidden"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "version"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "jar"
                },
                "value": {
                  "$ref": "#/properties/target/anyOf/0/properties/value"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "coordinate"
                },
                "value": {
                  "$ref": "#/properties/target/anyOf/0/properties/value"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "workspace"
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "vanilla",
                    "merged",
                    "loader"
                  ]
                },
                "strict": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "dependency"
                },
                "group": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Maven group, e.g. \"net.fabricmc.fabric-api\" or \"dev.architectury\"."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Maven artifact name, e.g. \"fabric-api\" or \"architectury\"."
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Explicit version; omit and set versionFromProject to resolve it from the workspace."
                },
                "versionFromProject": {
                  "type": "boolean",
                  "description": "Resolve the version from the project's gradle.properties / gradle cache (requires projectPath)."
                }
              },
              "required": [
                "kind",
                "group",
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "artifact"
                },
                "artifactId": {
                  "$ref": "#/properties/target/anyOf/0/properties/value"
                }
              },
              "required": [
                "kind",
                "artifactId"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Same shape as resolve-artifact target (incl. {\"kind\":\"dependency\",...} to read a Fabric/loader dependency class like vanilla), plus {\"kind\":\"artifact\",\"artifactId\":\"...\"} to reuse a resolved artifact. Object, not string."
        },
        "filePath": {
          "$ref": "#/properties/target/anyOf/0/properties/value"
        },
        "maxBytes": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "filePath"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "name": "get-artifact-file"
  },
  "envelopeSample": {
    "kind": "invalid-input",
    "request": {
      "id": 18,
      "jsonrpc": "2.0",
      "method": "tools/call",
      "params": {
        "arguments": {},
        "name": "get-artifact-file"
      }
    },
    "reply": {
      "id": 18,
      "jsonrpc": "2.0",
      "result": {
        "content": [
          {
            "text": {
              "__normalizedJson": {
                "error": {
                  "code": "ERR_INVALID_INPUT",
                  "detail": "Request validation failed.",
                  "fieldErrors": [
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "filePath"
                    }
                  ],
                  "hints": [
                    "Check fieldErrors and submit a valid tool argument payload."
                  ],
                  "instance": "<REQUEST_ID>",
                  "issueOrigin": "code_issue",
                  "retryClass": "input",
                  "status": 400,
                  "title": "Invalid input",
                  "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
                },
                "meta": {
                  "durationMs": "<DURATION_MS>",
                  "requestId": "<REQUEST_ID>",
                  "tool": "get-artifact-file"
                }
              }
            },
            "type": "text"
          }
        ],
        "isError": true,
        "structuredContent": {
          "error": {
            "code": "ERR_INVALID_INPUT",
            "detail": "Request validation failed.",
            "fieldErrors": [
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "filePath"
              }
            ],
            "hints": [
              "Check fieldErrors and submit a valid tool argument payload."
            ],
            "instance": "<REQUEST_ID>",
            "issueOrigin": "code_issue",
            "retryClass": "input",
            "status": 400,
            "title": "Invalid input",
            "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
          },
          "meta": {
            "durationMs": "<DURATION_MS>",
            "requestId": "<REQUEST_ID>",
            "tool": "get-artifact-file"
          }
        }
      }
    }
  }
}
