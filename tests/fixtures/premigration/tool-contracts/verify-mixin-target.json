{
  "description": "Pre-migration per-tool contract snapshot: advertised tools/list entry with VERBATIM inputSchema bytes (wire property order), plus one envelope sample. Untouched SDK v1 build; legacy handshake; default flag config.",
  "harness": "scripts/premigration/capture-tool-contracts.mjs",
  "env": {
    "MCP_CACHE_DIR": "<SCRATCH>/cache",
    "MCP_SQLITE_PATH": "<SCRATCH>/cache/source-cache.db",
    "MCP_SUPERVISOR_CHILD_PID_FILE": "<SCRATCH>/run/tool-contracts.pid"
  },
  "advertised": {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Single-call probe: does this target owner / member exist and which @Shadow / @Accessor / @Invoker should the mixin use? Reuses target.kind workspace/version/coordinate/dependency/jar.",
    "execution": {
      "taskSupport": "forbidden"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Fully-qualified target owner class name."
        },
        "member": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "method"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "descriptor": {
                  "type": "string",
                  "description": "Optional JVM method descriptor, e.g. \"()V\". Empty/whitespace strings are treated as omitted."
                }
              },
              "required": [
                "kind",
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "field"
                },
                "name": {
                  "$ref": "#/properties/member/anyOf/0/properties/name"
                },
                "descriptor": {
                  "$ref": "#/properties/member/anyOf/0/properties/descriptor",
                  "description": "Optional JVM field descriptor, e.g. \"I\". Empty/whitespace strings are treated as omitted."
                }
              },
              "required": [
                "kind",
                "name"
              ],
              "additionalProperties": false
            }
          ],
          "description": "e.g. {\"kind\":\"method\",\"name\":\"tick\",\"descriptor\":\"()V\"} or {\"kind\":\"field\",\"name\":\"airSupply\"}."
        },
        "mixinMemberName": {
          "type": "string",
          "minLength": 1,
          "description": "Caller-authored mixin member name; drives @Accessor/@Invoker advice when the target is private."
        },
        "mapping": {
          "type": "string",
          "enum": [
            "obfuscated",
            "mojang",
            "intermediary",
            "yarn"
          ]
        },
        "autoRemap": {
          "type": "boolean",
          "description": "Translate owner+member via find-mapping when mapping differs from the artifact namespace (requires a version-based target)."
        },
        "sourcePriority": {
          "type": "string",
          "enum": [
            "loom-first",
            "maven-first"
          ]
        },
        "projectPath": {
          "$ref": "#/properties/mixinMemberName",
          "description": "Workspace root path for target.kind=workspace and Loom cache assistance."
        },
        "gradleUserHome": {
          "$ref": "#/properties/mixinMemberName",
          "description": "Gradle user home for Loom cache lookups (overrides GRADLE_USER_HOME)."
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "version"
                },
                "value": {
                  "$ref": "#/properties/member/anyOf/0/properties/name"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "jar"
                },
                "value": {
                  "$ref": "#/properties/member/anyOf/0/properties/name"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "coordinate"
                },
                "value": {
                  "$ref": "#/properties/member/anyOf/0/properties/name"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "workspace"
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "vanilla",
                    "merged",
                    "loader"
                  ]
                },
                "strict": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "dependency"
                },
                "group": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Maven group, e.g. \"net.fabricmc.fabric-api\" or \"dev.architectury\"."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Maven artifact name, e.g. \"fabric-api\" or \"architectury\"."
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Explicit version; omit and set versionFromProject to resolve it from the workspace."
                },
                "versionFromProject": {
                  "type": "boolean",
                  "description": "Resolve the version from the project's gradle.properties / gradle cache (requires projectPath)."
                }
              },
              "required": [
                "kind",
                "group",
                "name"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Object, not string. e.g. {\"kind\":\"version\",\"value\":\"1.21.10\"}, {\"kind\":\"workspace\"}, or to inspect a loader/Fabric dependency like vanilla: {\"kind\":\"dependency\",\"group\":\"net.fabricmc.fabric-api\",\"name\":\"fabric-api\",\"versionFromProject\":true} (needs projectPath) or with an explicit \"version\"."
        },
        "scope": {
          "$ref": "#/properties/target/anyOf/3/properties/scope",
          "description": "vanilla = Mojang client jar only; merged = merged runtime discovery; loader = loader-transformed runtime jars."
        },
        "preferProjectVersion": {
          "type": "boolean",
          "description": "Detect MC version from gradle.properties and override target.value"
        },
        "strictVersion": {
          "type": "boolean",
          "description": "Reject version-approximated results (default false)"
        }
      },
      "required": [
        "owner",
        "member",
        "target"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "name": "verify-mixin-target"
  },
  "envelopeSample": {
    "kind": "invalid-input",
    "request": {
      "id": 43,
      "jsonrpc": "2.0",
      "method": "tools/call",
      "params": {
        "arguments": {},
        "name": "verify-mixin-target"
      }
    },
    "reply": {
      "id": 43,
      "jsonrpc": "2.0",
      "result": {
        "content": [
          {
            "text": {
              "__normalizedJson": {
                "error": {
                  "code": "ERR_INVALID_INPUT",
                  "detail": "Request validation failed.",
                  "fieldErrors": [
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "owner"
                    },
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "member"
                    },
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "target"
                    }
                  ],
                  "hints": [
                    "Check fieldErrors and submit a valid tool argument payload."
                  ],
                  "instance": "<REQUEST_ID>",
                  "issueOrigin": "code_issue",
                  "retryClass": "input",
                  "status": 400,
                  "title": "Invalid input",
                  "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
                },
                "meta": {
                  "durationMs": "<DURATION_MS>",
                  "requestId": "<REQUEST_ID>",
                  "tool": "verify-mixin-target"
                }
              }
            },
            "type": "text"
          }
        ],
        "isError": true,
        "structuredContent": {
          "error": {
            "code": "ERR_INVALID_INPUT",
            "detail": "Request validation failed.",
            "fieldErrors": [
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "owner"
              },
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "member"
              },
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "target"
              }
            ],
            "hints": [
              "Check fieldErrors and submit a valid tool argument payload."
            ],
            "instance": "<REQUEST_ID>",
            "issueOrigin": "code_issue",
            "retryClass": "input",
            "status": 400,
            "title": "Invalid input",
            "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
          },
          "meta": {
