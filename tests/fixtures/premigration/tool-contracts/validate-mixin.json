{
  "description": "Pre-migration per-tool contract snapshot: advertised tools/list entry with VERBATIM inputSchema bytes (wire property order), plus one envelope sample. Untouched SDK v1 build; legacy handshake; default flag config.",
  "harness": "scripts/premigration/capture-tool-contracts.mjs",
  "env": {
    "MCP_CACHE_DIR": "<SCRATCH>/cache",
    "MCP_SQLITE_PATH": "<SCRATCH>/cache/source-cache.db",
    "MCP_SUPERVISOR_CHILD_PID_FILE": "<SCRATCH>/run/tool-contracts.pid"
  },
  "advertised": {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Validate Mixin source against Minecraft bytecode signatures for a given version. Expert tool: prefer the entry tools (inspect-minecraft, analyze-symbol, compare-minecraft, analyze-mod, validate-project) first.",
    "execution": {
      "taskSupport": "forbidden"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "input": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "inline"
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Mixin Java source text"
                }
              },
              "required": [
                "mode",
                "source"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "path"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Path to a Mixin .java file"
                }
              },
              "required": [
                "mode",
                "path"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "paths"
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "description": "Array of Mixin .java file paths for batch validation"
                }
              },
              "required": [
                "mode",
                "paths"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "config"
                },
                "configPaths": {
                  "type": "array",
                  "items": {
                    "$ref": "#/properties/input/anyOf/2/properties/paths/items"
                  },
                  "minItems": 1,
                  "description": "Path array to mixin config JSON files (e.g. modid.mixins.json)"
                }
              },
              "required": [
                "mode",
                "configPaths"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "project"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Workspace root path used to discover *.mixins.json files automatically"
                }
              },
              "required": [
                "mode",
                "path"
              ],
              "additionalProperties": false
            }
          ],
          "description": "mode = inline | path | paths | config | project"
        },
        "sourceRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Source roots for multi-module projects (e.g. ['common/src/main/java'])"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Minecraft version. Optional when input.mode='project' or preferProjectVersion=true with projectPath; required otherwise."
        },
        "mapping": {
          "type": "string",
          "enum": [
            "obfuscated",
            "mojang",
            "intermediary",
            "yarn"
          ]
        },
        "sourcePriority": {
          "type": "string",
          "enum": [
            "loom-first",
            "maven-first"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "vanilla",
            "merged",
            "loader"
          ],
          "description": "vanilla = Mojang client jar only; merged = merged runtime discovery; loader = loader-transformed runtime jars."
        },
        "projectPath": {
          "$ref": "#/properties/version",
          "description": "Workspace root for Loom cache-assisted resolution"
        },
        "gradleUserHome": {
          "$ref": "#/properties/version",
          "description": "Gradle user home for Loom cache lookups (overrides GRADLE_USER_HOME)."
        },
        "preferProjectVersion": {
          "type": "boolean",
          "description": "Detect MC version from gradle.properties and override version"
        },
        "minSeverity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "all"
          ],
          "default": "all",
          "description": "'error'=errors only, 'warning'=errors+warnings, 'all'=everything"
        },
        "hideUncertain": {
          "type": "boolean",
          "default": false,
          "description": "Omit issues with confidence='uncertain'"
        },
        "explain": {
          "type": "boolean",
          "default": false,
          "description": "When true, enrich each issue with explanation and suggestedCall for agent recovery"
        },
        "warningMode": {
          "type": "string",
          "enum": [
            "full",
            "aggregated"
          ],
          "description": "'full'=all warnings; 'aggregated'=group warnings by category with counts and samples. Single validation uses the provided value as-is; batch validation defaults to 'aggregated'"
        },
        "preferProjectMapping": {
          "type": "boolean",
          "default": false,
          "description": "When true, auto-detect mapping from project config even if mapping is explicitly provided"
        },
        "reportMode": {
          "type": "string",
          "enum": [
            "compact",
            "full",
            "summary-first"
          ],
          "default": "summary-first",
          "description": "summary-first (default) hoists shared provenance/warnings, drops per-result heavy detail; compact omits heavy per-result detail; full = everything (required for resolvedMembers/toolHealth/resolutionTrace unless explain=true)."
        },
        "warningCategoryFilter": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mapping",
              "configuration",
              "validation",
              "resolution",
              "parse"
            ]
          },
          "description": "Only include warnings/issues matching these categories (default: all)"
        },
        "treatInfoAsWarning": {
          "type": "boolean",
          "default": true,
          "description": "When false, suppress info-severity structured warnings from output"
        },
        "includeIssues": {
          "type": "boolean",
          "default": true,
          "description": "When false, keep summary fields but omit per-result issues[] payloads"
        }
      },
      "required": [
        "input"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "name": "validate-mixin"
  },
  "envelopeSample": {
    "kind": "invalid-input",
    "request": {
      "id": 41,
      "jsonrpc": "2.0",
      "method": "tools/call",
      "params": {
        "arguments": {},
        "name": "validate-mixin"
      }
    },
    "reply": {
      "id": 41,
      "jsonrpc": "2.0",
      "result": {
        "content": [
          {
            "text": {
              "__normalizedJson": {
                "error": {
                  "code": "ERR_INVALID_INPUT",
                  "detail": "Request validation failed.",
                  "exampleCalls": [
                    {
                      "params": {
                        "input": {
                          "mode": "inline",
                          "source": "<Mixin Java source>"
                        },
                        "version": "<minecraft-version>"
                      },
                      "reason": "Example validate-mixin call shape — replace any <…> placeholder values before sending.",
                      "tool": "validate-mixin",
                      "valid": true
                    }
                  ],
                  "failedStage": "input-validation",
                  "fieldErrors": [
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "input"
                    }
                  ],
                  "hints": [
                    "validate-mixin.input must be an object with input.mode = \"inline\" | \"path\" | \"paths\" | \"config\" | \"project\".",
                    "Whole-project example: {\"input\":{\"mode\":\"project\",\"path\":\"/workspace\"},\"version\":\"1.21.10\",\"preferProjectVersion\":true,\"preferProjectMapping\":true}.",
                    "Legacy top-level source/sourcePath/sourcePaths/mixinConfigPath fields are no longer accepted; wrap them under input.mode instead.",
                    "suggested call payload failed schema validation; using fallback examples"
                  ],
                  "instance": "<REQUEST_ID>",
                  "issueOrigin": "code_issue",
                  "retryClass": "input",
                  "status": 400,
                  "title": "Invalid input",
                  "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
                },
                "meta": {
                  "durationMs": "<DURATION_MS>",
                  "requestId": "<REQUEST_ID>",
                  "tool": "validate-mixin"
                }
              }
            },
            "type": "text"
          }
        ],
        "isError": true,
        "structuredContent": {
          "error": {
            "code": "ERR_INVALID_INPUT",
            "detail": "Request validation failed.",
            "exampleCalls": [
              {
                "params": {
                  "input": {
                    "mode": "inline",
                    "source": "<Mixin Java source>"
                  },
                  "version": "<minecraft-version>"
                },
                "reason": "Example validate-mixin call shape — replace any <…> placeholder values before sending.",
                "tool": "validate-mixin",
                "valid": true
              }
            ],
            "failedStage": "input-validation",
            "fieldErrors": [
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "input"
              }
            ],
            "hints": [
              "validate-mixin.input must be an object with input.mode = \"inline\" | \"path\" | \"paths\" | \"config\" | \"project\".",
              "Whole-project example: {\"input\":{\"mode\":\"project\",\"path\":\"/workspace\"},\"version\":\"1.21.10\",\"preferProjectVersion\":true,\"preferProjectMapping\":true}.",
              "Legacy top-level source/sourcePath/sourcePaths/mixinConfigPath fields are no longer accepted; wrap them under input.mode instead.",
              "suggested call payload failed schema validation; using fallback examples"
            ],
            "instance": "<REQUEST_ID>",
            "issueOrigin": "code_issue",
            "retryClass": "input",
            "status": 400,
            "title": "Invalid input",
            "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
          },
          "meta": {
            "durationMs": "<DURATION_MS>",
