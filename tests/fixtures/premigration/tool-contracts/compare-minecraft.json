{
  "description": "Pre-migration per-tool contract snapshot: advertised tools/list entry with VERBATIM inputSchema bytes (wire property order), plus one envelope sample. Untouched SDK v1 build; legacy handshake; default flag config.",
  "harness": "scripts/premigration/capture-tool-contracts.mjs",
  "env": {
    "MCP_CACHE_DIR": "<SCRATCH>/cache",
    "MCP_SQLITE_PATH": "<SCRATCH>/cache/source-cache.db",
    "MCP_SUPERVISOR_CHILD_PID_FILE": "<SCRATCH>/run/tool-contracts.pid"
  },
  "advertised": {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Top-level workflow tool for version comparisons, class diffs, registry diffs, and migration overviews.",
    "execution": {
      "taskSupport": "forbidden"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "enum": [
            "auto",
            "versions",
            "class-diff",
            "registry-diff",
            "migration-overview"
          ]
        },
        "subject": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "version-pair"
                },
                "fromVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "toVersion": {
                  "$ref": "#/properties/subject/anyOf/0/properties/fromVersion"
                },
                "packageFilter": {
                  "$ref": "#/properties/subject/anyOf/0/properties/fromVersion"
                }
              },
              "required": [
                "kind",
                "fromVersion",
                "toVersion"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "class"
                },
                "className": {
                  "$ref": "#/properties/subject/anyOf/0/properties/fromVersion"
                },
                "fromVersion": {
                  "$ref": "#/properties/subject/anyOf/0/properties/fromVersion"
                },
                "toVersion": {
                  "$ref": "#/properties/subject/anyOf/0/properties/fromVersion"
                },
                "mapping": {
                  "type": "string",
                  "enum": [
                    "obfuscated",
                    "mojang",
                    "intermediary",
                    "yarn"
                  ]
                },
                "sourcePriority": {
                  "type": "string",
                  "enum": [
                    "loom-first",
                    "maven-first"
                  ]
                },
                "gradleUserHome": {
                  "$ref": "#/properties/subject/anyOf/0/properties/fromVersion"
                }
              },
              "required": [
                "kind",
                "className",
                "fromVersion",
                "toVersion"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "registry"
                },
                "fromVersion": {
                  "$ref": "#/properties/subject/anyOf/0/properties/fromVersion"
                },
                "toVersion": {
                  "$ref": "#/properties/subject/anyOf/0/properties/fromVersion"
                },
                "registry": {
                  "$ref": "#/properties/subject/anyOf/0/properties/fromVersion"
                }
              },
              "required": [
                "kind",
                "fromVersion",
                "toVersion"
              ],
              "additionalProperties": false
            }
          ]
        },
        "detail": {
          "type": "string",
          "enum": [
            "summary",
            "standard",
            "full"
          ]
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "warnings",
              "classes",
              "registry",
              "diff",
              "samples",
              "timings"
            ]
          }
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "maxClassResults": {
          "$ref": "#/properties/limit",
          "default": 500
        },
        "maxEntriesPerRegistry": {
          "$ref": "#/properties/limit"
        },
        "includeFullDiff": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "subject"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "name": "compare-minecraft"
  },
  "envelopeSample": {
    "kind": "invalid-input",
    "request": {
      "id": 12,
      "jsonrpc": "2.0",
      "method": "tools/call",
      "params": {
        "arguments": {},
        "name": "compare-minecraft"
      }
    },
    "reply": {
      "id": 12,
      "jsonrpc": "2.0",
      "result": {
        "content": [
          {
            "text": {
              "__normalizedJson": {
                "error": {
                  "code": "ERR_INVALID_INPUT",
                  "detail": "Request validation failed.",
                  "fieldErrors": [
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "subject"
                    }
                  ],
                  "hints": [
                    "Check fieldErrors and submit a valid tool argument payload."
                  ],
                  "instance": "<REQUEST_ID>",
                  "issueOrigin": "code_issue",
                  "retryClass": "input",
                  "status": 400,
                  "title": "Invalid input",
                  "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
                },
                "meta": {
                  "durationMs": "<DURATION_MS>",
                  "requestId": "<REQUEST_ID>",
                  "tool": "compare-minecraft"
                }
              }
            },
            "type": "text"
          }
        ],
        "isError": true,
        "structuredContent": {
          "error": {
            "code": "ERR_INVALID_INPUT",
            "detail": "Request validation failed.",
            "fieldErrors": [
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "subject"
              }
            ],
            "hints": [
              "Check fieldErrors and submit a valid tool argument payload."
            ],
            "instance": "<REQUEST_ID>",
            "issueOrigin": "code_issue",
            "retryClass": "input",
            "status": 400,
            "title": "Invalid input",
            "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
          },
          "meta": {
            "durationMs": "<DURATION_MS>",
            "requestId": "<REQUEST_ID>",
            "tool": "compare-minecraft"
          }
        }
      }
    }
  }
}
