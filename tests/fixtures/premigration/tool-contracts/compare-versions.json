{
  "description": "Pre-migration per-tool contract snapshot: advertised tools/list entry with VERBATIM inputSchema bytes (wire property order), plus one envelope sample. Untouched SDK v1 build; legacy handshake; default flag config.",
  "harness": "scripts/premigration/capture-tool-contracts.mjs",
  "env": {
    "MCP_CACHE_DIR": "<SCRATCH>/cache",
    "MCP_SQLITE_PATH": "<SCRATCH>/cache/source-cache.db",
    "MCP_SUPERVISOR_CHILD_PID_FILE": "<SCRATCH>/run/tool-contracts.pid"
  },
  "advertised": {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Compare two Minecraft versions to find added/removed classes and registry entry changes. Expert tool: prefer the entry tools (inspect-minecraft, analyze-symbol, compare-minecraft, analyze-mod, validate-project) first.",
    "execution": {
      "taskSupport": "forbidden"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "fromVersion": {
          "type": "string",
          "minLength": 1,
          "description": "Older Minecraft version (e.g. 1.20.4)"
        },
        "toVersion": {
          "type": "string",
          "minLength": 1,
          "description": "Newer Minecraft version (e.g. 1.21)"
        },
        "category": {
          "type": "string",
          "enum": [
            "classes",
            "registry",
            "all"
          ],
          "default": "all"
        },
        "packageFilter": {
          "type": "string",
          "minLength": 1,
          "description": "Filter classes to a package prefix (e.g. net.minecraft.world.item)"
        },
        "maxClassResults": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 500,
          "description": "Max class results per direction (max 5000)"
        }
      },
      "required": [
        "fromVersion",
        "toVersion"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "name": "compare-versions"
  },
  "envelopeSample": {
    "kind": "invalid-input",
    "request": {
      "id": 13,
      "jsonrpc": "2.0",
      "method": "tools/call",
      "params": {
        "arguments": {},
        "name": "compare-versions"
      }
    },
    "reply": {
      "id": 13,
      "jsonrpc": "2.0",
      "result": {
        "content": [
          {
            "text": {
              "__normalizedJson": {
                "error": {
                  "code": "ERR_INVALID_INPUT",
                  "detail": "Request validation failed.",
                  "fieldErrors": [
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "fromVersion"
                    },
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "toVersion"
                    }
                  ],
                  "hints": [
                    "Check fieldErrors and submit a valid tool argument payload."
                  ],
                  "instance": "<REQUEST_ID>",
                  "issueOrigin": "code_issue",
                  "retryClass": "input",
                  "status": 400,
                  "title": "Invalid input",
                  "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
                },
                "meta": {
                  "durationMs": "<DURATION_MS>",
                  "requestId": "<REQUEST_ID>",
                  "tool": "compare-versions"
                }
              }
            },
            "type": "text"
          }
        ],
        "isError": true,
        "structuredContent": {
          "error": {
            "code": "ERR_INVALID_INPUT",
            "detail": "Request validation failed.",
            "fieldErrors": [
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "fromVersion"
              },
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "toVersion"
              }
            ],
            "hints": [
              "Check fieldErrors and submit a valid tool argument payload."
            ],
            "instance": "<REQUEST_ID>",
            "issueOrigin": "code_issue",
            "retryClass": "input",
            "status": 400,
            "title": "Invalid input",
            "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
          },
          "meta": {
            "durationMs": "<DURATION_MS>",
            "requestId": "<REQUEST_ID>",
            "tool": "compare-versions"
          }
        }
      }
    }
  }
}
