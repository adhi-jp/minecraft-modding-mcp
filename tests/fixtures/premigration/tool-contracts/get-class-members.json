              }
            ],
            "hints": [
              "get-class-members.target must be an object: {\"kind\":\"version|jar|coordinate\",\"value\":\"...\"}, {\"kind\":\"workspace\"}, {\"kind\":\"dependency\",\"group\":\"...\",\"name\":\"...\",\"versionFromProject\":true} (inspect a Fabric/loader dependency like vanilla), or {\"kind\":\"artifact\",\"artifactId\":\"...\"} (same shape as resolve-artifact).",
              "Bare string targets are not accepted; wrap the value under target.kind/target.value.",
              "suggested call payload failed schema validation; using fallback examples"
            ],
            "instance": "<REQUEST_ID>",
            "issueOrigin": "code_issue",
            "retryClass": "input",
            "status": 400,
            "title": "Invalid input",
            "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
          },
          "meta": {
