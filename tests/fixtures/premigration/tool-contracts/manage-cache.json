{
  "description": "Pre-migration per-tool contract snapshot: advertised tools/list entry with VERBATIM inputSchema bytes (wire property order), plus one envelope sample. Untouched SDK v1 build; legacy handshake; default flag config.",
  "harness": "scripts/premigration/capture-tool-contracts.mjs",
  "env": {
    "MCP_CACHE_DIR": "<SCRATCH>/cache",
    "MCP_SQLITE_PATH": "<SCRATCH>/cache/source-cache.db",
    "MCP_SUPERVISOR_CHILD_PID_FILE": "<SCRATCH>/run/tool-contracts.pid"
  },
  "advertised": {
    "annotations": {
      "readOnlyHint": false
    },
    "description": "Top-level workflow tool for cache summaries, listing, verification, previewed mutation, and explicit apply operations.",
    "execution": {
      "taskSupport": "forbidden"
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "summary",
            "list",
            "inspect",
            "delete",
            "prune",
            "rebuild",
            "verify"
          ]
        },
        "cacheKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "artifact-index",
              "downloads",
              "mapping",
              "registry",
              "decompiled-source",
              "mod-remap",
              "binary-remap",
              "nested-jar",
              "workspace"
            ]
          }
        },
        "selector": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "$ref": "#/properties/selector/properties/artifactId"
            },
            "jarPath": {
              "$ref": "#/properties/selector/properties/artifactId"
            },
            "entryId": {
              "$ref": "#/properties/selector/properties/artifactId"
            },
            "status": {
              "type": "string",
              "enum": [
                "healthy",
                "partial",
                "stale",
                "orphaned",
                "corrupt",
                "in_use"
              ]
            },
            "olderThan": {
              "$ref": "#/properties/selector/properties/artifactId"
            },
            "mapping": {
              "$ref": "#/properties/selector/properties/artifactId"
            },
            "scope": {
              "$ref": "#/properties/selector/properties/artifactId"
            },
            "projectPath": {
              "$ref": "#/properties/selector/properties/artifactId"
            }
          },
          "additionalProperties": false
        },
        "detail": {
          "type": "string",
          "enum": [
            "summary",
            "standard",
            "full"
          ]
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "warnings",
              "cacheEntries",
              "paths",
              "owners",
              "health",
              "preview",
              "timings"
            ]
          }
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 50
        },
        "cursor": {
          "$ref": "#/properties/selector/properties/artifactId"
        },
        "executionMode": {
          "type": "string",
          "enum": [
            "preview",
            "apply"
          ],
          "default": "preview"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "name": "manage-cache"
  },
  "envelopeSample": {
    "kind": "invalid-input",
    "request": {
      "id": 29,
      "jsonrpc": "2.0",
      "method": "tools/call",
      "params": {
        "arguments": {},
        "name": "manage-cache"
      }
    },
    "reply": {
      "id": 29,
      "jsonrpc": "2.0",
      "result": {
        "content": [
          {
            "text": {
              "__normalizedJson": {
                "error": {
                  "code": "ERR_INVALID_INPUT",
                  "detail": "Request validation failed.",
                  "fieldErrors": [
                    {
                      "code": "invalid_type",
                      "message": "Required",
                      "path": "action"
                    }
                  ],
                  "hints": [
                    "Check fieldErrors and submit a valid tool argument payload."
                  ],
                  "instance": "<REQUEST_ID>",
                  "issueOrigin": "code_issue",
                  "retryClass": "input",
                  "status": 400,
                  "title": "Invalid input",
                  "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
                },
                "meta": {
                  "durationMs": "<DURATION_MS>",
                  "requestId": "<REQUEST_ID>",
                  "tool": "manage-cache"
                }
              }
            },
            "type": "text"
          }
        ],
        "isError": true,
        "structuredContent": {
          "error": {
            "code": "ERR_INVALID_INPUT",
            "detail": "Request validation failed.",
            "fieldErrors": [
              {
                "code": "invalid_type",
                "message": "Required",
                "path": "action"
              }
            ],
            "hints": [
              "Check fieldErrors and submit a valid tool argument payload."
            ],
            "instance": "<REQUEST_ID>",
            "issueOrigin": "code_issue",
            "retryClass": "input",
            "status": 400,
            "title": "Invalid input",
            "type": "https://minecraft-modding-mcp.dev/problems/invalid-input"
          },
          "meta": {
            "durationMs": "<DURATION_MS>",
            "requestId": "<REQUEST_ID>",
            "tool": "manage-cache"
          }
        }
      }
    }
  }
}
